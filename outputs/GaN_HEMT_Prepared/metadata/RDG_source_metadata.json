            {
              "typeName": "dsDescription",
              "multiple": true,
              "typeClass": "compound",
              "value": [
                {
                  "dsDescriptionValue": {
                    "typeName": "dsDescriptionValue",
                    "multiple": false,
                    "typeClass": "primitive",
                    "value": "In order to create compact models for circuit simulations in LTspice, a characterization protocol was established, as shown in the Characterization_flowchart. This procedure was applied to two different transistors, named TLN2 and GS65030.\n\nThis folder is divided into three parts:\n\n01) A flowchart for the procedure of HEMT transistor characterization using a B1505A curve tracer.\n\n02) A dataset containing static (I–V) and dynamic (C–V) measurements for both HEMT transistors TLN2 and GS65030\n\n03) A set of scripts designed to:\n- Process measurement data (Id–Vgs, Id–Vds, Id–Vsd)\n- Fit mathematical models to the different I–V functions\n- Process measurement data (Crss–Vds, Coss–Vds, Ciss–Vds)\n- Fit mathematical models to the different C–V functions\n- Generate a “.lib” file that allows the component to be reused in LTspice\n\nA file named \"README_HEMT_Modeling.txt\" is available for further details on the various functions.\n\nAll datasets and scripts are fully reusable and are provided to support transparency, reproducibility, and further research. They accompany a journal paper that is currently under preparation."
                  },
                  "dsDescriptionLanguage": {
                    "typeName": "dsDescriptionLanguage",
                    "multiple": false,
                    "typeClass": "controlledVocabulary",
                    "value": "English"
                  },
                  "dsDescriptionDate": {
                    "typeName": "dsDescriptionDate",
                    "multiple": false,
                    "typeClass": "primitive",
                    "value": "2025-11-07"
                  }
                }
              ]
