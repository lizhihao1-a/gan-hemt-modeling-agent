    },
    {
      "field": "pulse_period_s",
      "type": "number",
      "unit": "s",
      "missing": "空单元格 / JSON null",
      "description": "仅 VPULSE 模式采用原 Period，单位秒"
    },
    {
      "field": "pulse_delay_s",
      "type": "number",
      "unit": "s",
      "missing": "空单元格 / JSON null",
      "description": "原脉冲 Delay，单位秒"
    },
    {
      "field": "pulse_measurement_delay_s",
      "type": "number",
      "unit": "s",
      "missing": "空单元格 / JSON null",
      "description": "原脉冲 MeasurementDelay，单位秒"
    },
    {
      "field": "pulse_vds_base_V",
      "type": "number",
      "unit": "V",
      "missing": "空单元格 / JSON null",
      "description": "仅当 Vds 通道为 VPULSE 时填写原 Base"
    },
    {
      "field": "pulse_vgs_base_V",
      "type": "number",
      "unit": "V",
      "missing": "空单元格 / JSON null",
      "description": "仅当 Vgs 通道为 VPULSE 时填写原 Base；当前缺失"
    },
    {
      "field": "drain_current_limit_A",
      "type": "number",
      "unit": "A",
      "missing": "空单元格 / JSON null",
      "description": "按通道功能映射的原电流限值绝对值"
    },
    {
      "field": "gate_current_limit_A",
      "type": "number",
      "unit": "A",
      "missing": "空单元格 / JSON null",
      "description": "按通道功能映射的原电流限值绝对值"
    },
    {
      "field": "near_current_limit",
      "type": "boolean (0/1 in CSV)",
      "unit": "",
      "missing": "空单元格 / JSON null",
      "description": "|Id| >= 0.99 × 漏极限流设置，仅启发式标记"
    },
    {
      "field": "bias_deviation",
      "type": "boolean (0/1 in CSV)",
      "unit": "",
      "missing": "空单元格 / JSON null",
      "description": "任一实际电压与设定值之差 > max(0.02 V, 设定值绝对值的 1%)"
    },
    {
      "field": "compliance_suspected",
      "type": "boolean (0/1 in CSV)",
      "unit": "",
      "missing": "空单元格 / JSON null",
      "description": "near_current_limit 与 bias_deviation 同时满足；非仪器状态码"
    },
    {
      "field": "nonpositive_forward_id",
      "type": "boolean (0/1 in CSV)",
      "unit": "",
      "missing": "空单元格 / JSON null",
      "description": "正向 output/transfer 数据 Id <= 0；未删除"
    },
    {
      "field": "negative_gm",
      "type": "boolean (0/1 in CSV)",
      "unit": "",
      "missing": "空单元格 / JSON null",
      "description": "原始 gm < 0；未删除或平滑"
    },
    {
      "field": "quality_flags",
      "type": "string",
      "unit": "",
      "missing": "空单元格 / JSON null",
      "description": "分号分隔；包含缺失条件与需复核信息"
    },
    {
      "field": "source_id",
      "type": "string",
      "unit": "",
