    },
    {
      "field": "temperature_context_K",
      "type": "number",
      "unit": "K",
      "missing": "空单元格 / JSON null",
      "description": "DFO MDL TEMP=25 C 转换为 298.15 K，仅为模型上下文"
    },
    {
      "field": "frequency_Hz",
      "type": "number",
      "unit": "Hz",
