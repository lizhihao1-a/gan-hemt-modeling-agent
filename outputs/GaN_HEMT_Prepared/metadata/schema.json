{
  "schema_version": "1.0",
  "fields": [
    {
      "field": "point_id",
      "type": "string",
      "unit": "",
      "missing": "空单元格 / JSON null",
      "description": "来源文件哈希及原记录位置构成的稳定记录 ID"
    },
    {
      "field": "device_id",
      "type": "string",
      "unit": "",
      "missing": "空单元格 / JSON null",
      "description": "名义器件组；不等于已确认的物理样品序列号"
    },
    {
      "field": "measurement_type",
      "type": "string",
      "unit": "",
      "missing": "空单元格 / JSON null",
      "description": "output_iv / transfer_iv / reverse_iv / cv / iv_gm_grid"
    },
    {
      "field": "mode",
      "type": "string",
      "unit": "",
      "missing": "空单元格 / JSON null",
      "description": "continuous / pulsed / ac / unspecified；DFO CSV 未记录波形模式"
    },
    {
      "field": "curve_id",
      "type": "string",
      "unit": "",
      "missing": "空单元格 / JSON null",
      "description": "RDG 按 Dimension1/Dimension2 分组；DFO 按原 vg 坐标分组"
    },
    {
      "field": "train_test_split",
      "type": "string",
      "unit": "",
      "missing": "空单元格 / JSON null",
      "description": "DFO 原作者 train/test；RDG 为 unassigned"
    },
    {
      "field": "vds_V",
      "type": "number",
      "unit": "V",
      "missing": "空单元格 / JSON null",
      "description": "RDG 实际记录漏源电压；DFO 原 vd 偏置坐标"
    },
    {
      "field": "vgs_V",
      "type": "number",
      "unit": "V",
      "missing": "空单元格 / JSON null",
      "description": "RDG 实际记录栅源电压；DFO 原 vg 偏置坐标"
    },
    {
      "field": "id_A",
      "type": "number",
      "unit": "A",
      "missing": "空单元格 / JSON null",
      "description": "保留原始带符号 Ids / id_meas，未归一化"
    },
    {
      "field": "ig_A",
      "type": "number",
      "unit": "A",
      "missing": "空单元格 / JSON null",
      "description": "原始 Igs"
    },
    {
      "field": "gm_S",
      "type": "number",
      "unit": "S",
      "missing": "空单元格 / JSON null",
      "description": "原作者 gm_meas，保留负值；未对 RDG 估算 gm"
    },
    {
      "field": "capacitance_F",
      "type": "number",
      "unit": "F",
      "missing": "空单元格 / JSON null",
      "description": "原始 C；物理类型见 capacitance_type"
    },
    {
      "field": "conductance_S",
      "type": "number",
      "unit": "S",
      "missing": "空单元格 / JSON null",
      "description": "原始 G，按电导 SI 约定标记；负值保留"
    },
    {
      "field": "capacitance_type",
      "type": "string",
      "unit": "",
      "missing": "空单元格 / JSON null",
      "description": "Ciss / Coss / Crss；未转为本征 Cgs/Cgd/Cds"
    },
    {
      "field": "vds_set_V",
      "type": "number",
      "unit": "V",
      "missing": "空单元格 / JSON null",
      "description": "由原始扫描参数重建的漏极设定电压，区别于实际值"
    },
    {
      "field": "vgs_set_V",
      "type": "number",
      "unit": "V",
      "missing": "空单元格 / JSON null",
      "description": "由原始扫描参数重建的栅极设定电压，区别于实际值"
    },
    {
      "field": "temperature_K",
      "type": "number",
      "unit": "K",
      "missing": "空单元格 / JSON null",
