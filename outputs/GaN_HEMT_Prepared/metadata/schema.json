    }
  ],
  "null_policy": "CSV empty cell / JSON null; never fill absent conditions with zero.",
  "sign_policy": "Preserve measured Vds/Ids signs, including reverse conduction.",
  "transformations": [
    "Source-column mapping",
    "Dimension-based grouping",
    "Reconstructed programmed bias stored separately",
    "Original DFO split mapping",
    "Model-only temperature context separated from measurement temperature",
    "Review flags; no point deletion/smoothing/interpolation/width normalization"
  ]
