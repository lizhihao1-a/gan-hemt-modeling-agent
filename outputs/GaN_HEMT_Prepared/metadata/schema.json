    },
    {
      "field": "source_iteration",
      "type": "number",
      "unit": "",
      "missing": "空单元格 / JSON null",
      "description": "RDG TestRecord.IterationIndex"
    },
    {
      "field": "record_time_local",
      "type": "string",
      "unit": "",
      "missing": "空单元格 / JSON null",
